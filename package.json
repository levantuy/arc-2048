{
  "name": "2048",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "npm run test:contract",
    "test:all": "npm run test:contract && npm run test:ui",
    "test:contract": "hardhat test",
    "test:ui": "vitest run",
    "contract:compile": "hardhat compile",
    "contract:deploy:arc": "hardhat run scripts/deploy.js --network arcTestnet",
    "contract:deploy:arcTestnet": "hardhat run deploy.js --network arcTestnet",
    "contract:deploy:optimismSepolia": "hardhat run deploy.js --network optimismSepolia",
    "contract:deploy:sepolia": "hardhat run deploy.js --network sepolia",
    "contract:deploy:arbitrumSepolia": "hardhat run deploy.js --network arbitrumSepolia",
    "contract:deploy:baseSepolia": "hardhat run deploy.js --network baseSepolia",
    "contract:deploy:polygonAmoy": "hardhat run deploy.js --network polygonAmoy",
    "contract:deploy:arbitrum": "hardhat run deploy.js --network arbitrum",
    "contract:deploy:base": "hardhat run deploy.js --network base",
    "contract:deploy:polygon": "hardhat run deploy.js --network polygon",
    "contract:deploy:optimism": "hardhat run deploy.js --network optimism"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "viem": "^2.54.6"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.14",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.11",
    "@nomicfoundation/hardhat-mocha": "^3.0.21",
    "@openzeppelin/contracts": "^5.6.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "hardhat": "^3.9.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.16",
    "solc": "^0.8.35",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "diff": "^9.0.0",
    "serialize-javascript": "^7.0.7",
    "tmp": "^0.2.7"
  }
}
